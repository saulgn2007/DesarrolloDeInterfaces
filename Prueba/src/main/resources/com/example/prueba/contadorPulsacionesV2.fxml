<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="340.0" prefWidth="480.0" styleClass="contador" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prueba.controller.contadorPulsacionesV2Controller">
   <children>
      <Button fx:id="btnaumentar" id="btnaumentar" layoutX="151.0" layoutY="245.0" mnemonicParsing="false" onAction="#btn1" text="+" />
      <Button fx:id="btnrestar" id="btnrestar" layoutX="205.0" layoutY="245.0" mnemonicParsing="false" onAction="#btn2" text="-" />
      <Button fx:id="btnreset" id="btnreset" layoutX="259.0" layoutY="245.0" mnemonicParsing="false" onAction="#btn3" text="Reset" />
      <Label fx:id="miEtiqueta" layoutX="215.0" layoutY="45.0" prefHeight="48.0" prefWidth="50.0" styleClass="valor" text="0" textAlignment="CENTER" />
      <TextField fx:id="campoPulsaciones" id="campoPulsaciones" layoutX="140.0" layoutY="120.0" onAction="#establecerPulsaciones" promptText="Pulsaciones" />
      <ProgressBar fx:id="barraProgreso" id="barraProgreso" layoutX="120.0" layoutY="185.0" prefWidth="240.0" progress="0.0" />
   </children>
</AnchorPane>
